# Copy to .env (gitignored) to override compose defaults.
# Public port of the web app. 8088 locally; the droplet sets 80.
HTTP_PORT=8088
# Feed adapters: mock (default) or live — see docs/adapter-guide.md.
# APP_FLIGHT_SOURCE=mock
# APP_AIDX_SOURCE=mock
# APP_ACRIS_SOURCE=mock
# Creative assistant: mock (offline, default) or llm with any OpenAI-compatible endpoint.
# APP_CREATIVE_ASSISTANT_PROVIDER=llm
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1/
# OPENAI_MODEL=gpt-4o-mini
